# Production environment
NODE_ENV=production
PORT=3000
# REQUIRED: use a long random secret in production
APP_SECRET=replace-with-a-long-random-secret
HASH_SALT=replace-with-another-long-random-secret
# REQUIRED on first boot when data/db.json does not exist
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Session lifetime in seconds (8 hours default)
SESSION_TTL=28800
# Max request body size in bytes (50 MiB default)
MAX_BODY=52428800

# Supabase server-side integration
SUPABASE_URL=https://your-project.supabase.co
# New secret key for server-side Supabase access
SUPABASE_SECRET_KEY=sb_secret_...
# Temporary compatibility for Auth Admin create/update on hosted projects
# Keep this server-only; never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# AI Study Assistant (server-side only; never expose this key in frontend code)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna
